import { AboutSlint, Button, ComboBox, LineEdit, ListView, Palette, ScrollView, SpinBox, Switch } from "std-widgets.slint";

export struct Reading { label: string, value: string, detail: string, tone: int }
export struct LogLine { time: string, level: string, source: string, message: string, detail: string, selected: bool, tone: int }

global Theme {
    private property <color> palette-background: Palette.background;
    out property <bool> dark: palette-background.red < 128;
    out property <color> canvas: dark ? #121a17 : #f4f7f5;
    out property <color> surface: dark ? #19231f : #ffffff;
    out property <color> rail: dark ? #16201c : #eaf1ec;
    out property <color> line: dark ? #34433b : #dce6df;
    out property <color> ink: dark ? #e7f3eb : #172a22;
    out property <color> muted: dark ? #aabeb1 : #51695d;
    out property <color> accent: dark ? #99e3bd : #176349;
    out property <color> hero: dark ? #1d2d25 : #edf7f0;
    out property <color> soft: dark ? #253e32 : #e2f2e8;
    out property <color> amber: dark ? #f0cd95 : #875313;
    out property <color> red: dark ? #ffadab : #a73939;
    public pure function tone(kind: int) -> color { return kind == 1 ? accent : kind == 2 ? amber : kind == 3 ? red : muted; }
}

component Caption inherits Text {
    color: Theme.muted;
    font-size: 12px;
    overflow: elide;
}

component Heading inherits Text {
    color: Theme.ink;
    font-weight: 650;
    font-size: 17px;
    overflow: elide;
}

component Surface inherits Rectangle {
    border-width: 1px;
    border-color: Theme.line;
    border-radius: 14px;
    background: Theme.surface;
    @children
}

component Metric inherits Surface {
    in property <Reading> reading;
    min-height: 82px;
    VerticalLayout {
        padding: 12px; spacing: 3px;
        Caption { text: root.reading.label; }
        Heading { text: root.reading.value; color: root.reading.tone == 0 ? Theme.ink : Theme.tone(root.reading.tone); }
        Caption { text: root.reading.detail; }
    }
}

component Field inherits VerticalLayout {
    in property <string> label;
    spacing: 5px;
    Caption { text: root.label; }
    @children
}

export component MainWindow inherits Window {
    title: "Gnirehtet NG";
    icon: @image-url("../../assets/app-icon-256.png");
    default-font-family: "Segoe UI";
    background: Theme.canvas;
    min-width: 800px; min-height: 520px;
    preferred-width: 1080px; preferred-height: 745px;
    in-out property <int> page: 0;
    in-out property <int> appearance: 0;
    in-out property <int> device-index: -1;
    in-out property <int> port: 31416;
    in-out property <string> dns;
    in-out property <string> routes;
    in-out property <bool> auto-reconnect: true;
    in-out property <bool> minimize-to-tray;
    in-out property <bool> paused;
    in-out property <bool> follow-log: true;
    in-out property <int> level;
    in-out property <int> component-filter;
    in-out property <string> serial-filter;
    in-out property <string> search-filter;
    in property <string> version;
    in property <string> session: "Starting controller";
    in property <string> summary: "Looking for the USB controller…";
    in property <int> session-tone;
    in property <string> device-hint: "Looking for Android devices…";
    in property <string> message;
    in property <int> message-tone;
    in property <string> fault;
    in property <string> diagnostics-path;
    in property <string> controller-detail;
    in property <[string]> device-names;
    in property <[Reading]> device-details;
    in property <[Reading]> metrics;
    in property <[Reading]> health;
    in property <[LogLine]> log-rows;
    in property <[LogLine]> recent;
    in property <int> log-update;
    in property <bool> ready;
    in property <bool> busy;
    in property <bool> running;
    in property <bool> waiting;

    callback action(string);
    callback device-selected(int);
    callback preference-changed();
    callback filter-changed();
    callback log-selected(int);
    changed appearance => {
        Palette.color-scheme = root.appearance == 1 ? ColorScheme.light : root.appearance == 2 ? ColorScheme.dark : ColorScheme.unknown;
    }

    property <[string]> pages: ["Overview", "Devices", "Activity log", "Diagnostics", "Settings", "About"];
    property <[string]> subtitles: ["Share this computer’s connection with Android over USB.", "Choose which Android device receives the connection.", "Inspect events from the controller, relay and Android client.", "Review the connection checks and export a support bundle.", "Configure the next session and personalize the desktop app.", "USB reverse tethering for Android and Windows."];

    HorizontalLayout {
        spacing: 0px;
        Rectangle {
            width: 174px;
            background: Theme.rail;
            VerticalLayout {
                padding: 14px; spacing: 6px; alignment: start;
                HorizontalLayout {
                    height: 55px; spacing: 9px;
                    Image { source: @image-url("../../assets/app-icon-256.png"); width: 32px; height: 32px; image-fit: contain; }
                    VerticalLayout {
                        alignment: center; spacing: 1px;
                        Heading { text: "Gnirehtet NG"; font-size: 15px; }
                        Caption { text: "USB NETWORK"; font-size: 10px; }
                    }
                }
                Rectangle { height: 1px; background: Theme.line; }
                Rectangle { height: 5px; }
                for title[index] in root.pages: Button {
                    text: title; height: 35px;
                    primary: root.page == index;
                    clicked => { root.page = index; }
                }
                Rectangle { vertical-stretch: 1; }
                Caption { text: "DESKTOP  /  " + root.version; font-size: 10px; }
            }
        }

        VerticalLayout {
            padding: 20px; spacing: 12px;
            HorizontalLayout {
                spacing: 14px;
                VerticalLayout {
                    spacing: 2px;
                    Heading { text: root.pages[root.page]; font-size: 27px; }
                    Caption { text: root.subtitles[root.page]; }
                }
                Rectangle { horizontal-stretch: 1; }
                if root.page <= 1: VerticalLayout { alignment: center; Button { text: "Refresh devices"; height: 33px; enabled: !root.busy; clicked => { root.action("refresh"); } } }
            }
            if root.message != "": Rectangle {
                background: Theme.soft; border-radius: 8px; min-height: 33px;
                HorizontalLayout {
                    padding-left: 10px; padding-right: 6px; spacing: 6px;
                    Caption { text: root.message; color: Theme.tone(root.message-tone); vertical-alignment: center; }
                    Button { text: "Dismiss"; clicked => { root.action("dismiss"); } }
                }
            }
            if root.page == 0: ScrollView {
                VerticalLayout {
                    spacing: 12px; alignment: start;
                    Surface {
                        background: Theme.hero;
                        VerticalLayout {
                            padding: 14px; spacing: 9px;
                            HorizontalLayout {
                                spacing: 12px;
                                VerticalLayout {
                                    spacing: 4px;
                                    Caption { text: "USB SESSION"; color: Theme.accent; font-weight: 650; }
                                    Heading { text: root.session; font-size: 23px; color: root.session-tone == 0 ? Theme.ink : Theme.tone(root.session-tone); }
                                    Caption { text: root.summary; }
                                }
                                Rectangle { horizontal-stretch: 1; }
                                VerticalLayout {
                                    alignment: center;
                                    HorizontalLayout {
                                        spacing: 7px; height: 34px;
                                        Button { text: root.busy ? "Working…" : "Start"; primary: true; enabled: root.ready && !root.busy && !root.running && !root.waiting; clicked => { root.action("start"); } }
                                        Button { text: root.waiting ? "Cancel wait" : "Stop"; enabled: (root.running || root.waiting) && !root.busy; clicked => { root.action("stop"); } }
                                        Button { text: "Restart"; enabled: root.ready && root.running && !root.busy; clicked => { root.action("restart"); } }
                                    }
                                }
                            }
                            Rectangle { height: 1px; background: Theme.line; }
                            HorizontalLayout {
                                spacing: 14px;
                                ComboBox { model: root.device-names; current-index: root.device-index; enabled: !root.busy; selected => { root.device-selected(self.current-index); } }
                                Switch { text: "Auto-reconnect"; checked <=> root.auto-reconnect; toggled => { root.preference-changed(); } }
                            }
                            Caption { text: root.device-hint; }
                        }
                    }
                    HorizontalLayout {
                        spacing: 9px;
                        for item in root.metrics: Metric { reading: item; min-width: 0px; preferred-width: 1px; horizontal-stretch: 1; }
                    }
                    Surface {
                        VerticalLayout {
                            padding: 12px; spacing: 7px;
                            Heading { text: "Connection checks"; }
                            HorizontalLayout {
                                spacing: 7px;
                                for check in root.health: Rectangle {
                                    background: Theme.canvas; border-radius: 6px; horizontal-stretch: 1;
                                    VerticalLayout {
                                        padding: 7px; spacing: 3px;
                                        Caption { text: check.label; }
                                        Caption { text: check.value; color: Theme.tone(check.tone); font-weight: 650; }
                                    }
                                }
                            }
                            if root.fault != "": Caption { text: root.fault; color: Theme.amber; wrap: word-wrap; }
                        }
                    }
                    Surface {
                        VerticalLayout {
                            padding: 12px; spacing: 6px;
                            HorizontalLayout {
                                Heading { text: "Recent activity"; vertical-alignment: center; }
                                Rectangle { horizontal-stretch: 1; }
                                Button { text: "View log"; clicked => { root.page = 2; } }
                            }
                            if root.recent.length == 0: Caption { text: "Controller events will appear here."; }
                            for event in root.recent: HorizontalLayout {
                                spacing: 8px;
                                Caption { text: event.time; width: 70px; }
                                Caption { text: event.source; width: 74px; color: Theme.tone(event.tone); }
                                Caption { text: event.message; }
                            }
                        }
                    }
                }
            }
            if root.page == 1: ScrollView {
                VerticalLayout {
                    spacing: 10px; alignment: start;
                    Caption { text: root.device-hint; }
                    for device[index] in root.device-details: Surface {
                        HorizontalLayout {
                            padding: 13px; spacing: 14px;
                            VerticalLayout {
                                spacing: 4px;
                                Heading { text: device.label; }
                                Caption { text: device.detail; }
                            }
                            Rectangle { horizontal-stretch: 1; }
                            Caption { text: device.value; color: Theme.tone(device.tone); vertical-alignment: center; width: 110px; }
                            VerticalLayout { alignment: center; width: 86px; Button { height: 32px; text: root.device-index == index + 1 ? "Selected" : "Select"; enabled: root.device-index != index + 1 && !root.busy; clicked => { root.device-selected(index + 1); } } }
                        }
                    }
                }
            }
            if root.page == 2: VerticalLayout {
                spacing: 8px;
                HorizontalLayout {
                    spacing: 8px;
                    ComboBox { model: ["All levels", "Trace", "Debug", "Info", "Warn", "Error"]; current-index <=> root.level; selected => { root.filter-changed(); } }
                    ComboBox { model: ["All sources", "CORE", "ADB", "DEVICE", "RELAY", "ANDROID", "VPN", "NETWORK", "RECOVERY", "UI"]; current-index <=> root.component-filter; selected => { root.filter-changed(); } }
                    LineEdit { placeholder-text: "Device serial"; text <=> root.serial-filter; edited => { root.filter-changed(); } }
                    LineEdit { placeholder-text: "Search messages"; text <=> root.search-filter; edited => { root.filter-changed(); } }
                }
                HorizontalLayout {
                    spacing: 7px;
                    Switch { text: "Pause"; checked <=> root.paused; toggled => { root.filter-changed(); } }
                    Switch { text: "Auto-scroll"; checked <=> root.follow-log; toggled => { root.filter-changed(); } }
                    Rectangle { horizontal-stretch: 1; }
                    Button { text: "Clear view"; clicked => { root.action("clear"); } }
                    Button { text: "Copy selected"; clicked => { root.action("copy-selected"); } }
                    Button { text: "Copy all"; clicked => { root.action("copy-all"); } }
                    Button { text: "Export"; clicked => { root.action("export-log"); } }
                }
                Surface {
                    VerticalLayout {
                        padding: 7px; spacing: 5px;
                        HorizontalLayout {
                            padding-left: 5px; spacing: 8px;
                            Caption { text: "TIME (UTC)"; width: 82px; }
                            Caption { text: "LEVEL"; width: 52px; }
                            Caption { text: "SOURCE"; width: 78px; }
                            Caption { text: "EVENT · CLICK TO SELECT"; }
                        }
                        list := ListView {
                            property <int> scroll-trigger: root.log-update;
                            changed scroll-trigger => { if (root.follow-log) { self.content-y = max(0px, self.content-height - self.visible-height); } }
                            vertical-stretch: 1;
                            for event[index] in root.log-rows: Rectangle {
                                height: 30px;
                                border-radius: 5px;
                                background: event.selected ? Theme.soft : hit.has-hover ? Theme.canvas : Theme.surface;
                                accessible-role: button;
                                accessible-label: event.detail;
                                accessible-action-default => { root.log-selected(index); }
                                HorizontalLayout {
                                    padding-left: 5px; padding-right: 5px; spacing: 8px;
                                    Caption { text: event.time; width: 82px; vertical-alignment: center; }
                                    Caption { text: event.level; width: 52px; vertical-alignment: center; color: Theme.tone(event.tone); }
                                    Caption { text: event.source; width: 78px; vertical-alignment: center; }
                                    Caption { text: event.message; color: Theme.ink; vertical-alignment: center; }
                                }
                                hit := TouchArea { clicked => { root.log-selected(index); } }
                            }
                        }
                    }
                }
                Caption { text: root.log-rows.length + " visible events · Filters apply to copy and export"; }
            }
            if root.page == 3: ScrollView {
                VerticalLayout {
                    spacing: 10px; alignment: start;
                    Surface {
                        VerticalLayout {
                            padding: 15px; spacing: 9px;
                            Heading { text: "Support bundle"; }
                            Caption { text: "Collects the controller state and recent ADB, relay and Android logs."; }
                            HorizontalLayout {
                                spacing: 8px;
                                Button { text: "Export diagnostics"; primary: true; enabled: root.ready && !root.busy; clicked => { root.action("diagnose"); } }
                                if root.diagnostics-path != "": Button { text: "Show in Explorer"; clicked => { root.action("show-diagnostics"); } }
                                Rectangle { horizontal-stretch: 1; }
                            }
                            if root.diagnostics-path != "": Caption { text: root.diagnostics-path; wrap: word-wrap; }
                        }
                    }
                    Surface {
                        VerticalLayout {
                            padding: 15px; spacing: 8px;
                            Heading { text: "Live checks"; }
                            Caption { text: root.controller-detail; }
                            for check in root.health: HorizontalLayout {
                                Caption { text: check.label; width: 104px; }
                                Caption { text: check.value; color: Theme.tone(check.tone); width: 105px; }
                                Caption { text: check.detail; }
                            }
                            if root.fault != "": Caption { text: root.fault; color: Theme.amber; wrap: word-wrap; }
                        }
                    }
                }
            }
            if root.page == 4: ScrollView {
                VerticalLayout {
                    spacing: 10px; alignment: start;
                    Surface {
                        VerticalLayout {
                            padding: 15px; spacing: 10px;
                            Heading { text: "Appearance"; }
                            HorizontalLayout {
                                spacing: 14px;
                                Caption { text: "Match Windows or choose a fixed theme."; vertical-alignment: center; }
                                ComboBox { model: ["System", "Light", "Dark"]; current-index <=> root.appearance; selected => { root.preference-changed(); } }
                            }
                            Switch { text: "Close to notification area"; checked <=> root.minimize-to-tray; toggled => { root.preference-changed(); } }
                        }
                    }
                    Surface {
                        VerticalLayout {
                            padding: 15px; spacing: 10px;
                            Heading { text: "Session defaults"; }
                            Caption { text: "Changes apply the next time you start or restart a connection."; }
                            HorizontalLayout {
                                spacing: 9px;
                                Field { label: "Relay port"; SpinBox { minimum: 1024; maximum: 65535; value <=> root.port; } }
                                Field { label: "DNS servers"; LineEdit { text <=> root.dns; placeholder-text: "Default · comma-separated"; } }
                                Field { label: "IPv4 routes"; LineEdit { text <=> root.routes; placeholder-text: "Default · comma-separated CIDR"; } }
                            }
                            HorizontalLayout {
                                spacing: 12px;
                                Switch { text: "Auto-reconnect"; checked <=> root.auto-reconnect; toggled => { root.preference-changed(); } }
                                Rectangle { horizontal-stretch: 1; }
                                Button { text: "Save session defaults"; primary: true; clicked => { root.action("save"); } }
                            }
                        }
                    }
                }
            }
            if root.page == 5: ScrollView {
                VerticalLayout {
                    spacing: 10px; alignment: start;
                    Surface {
                        VerticalLayout {
                            padding: 16px; spacing: 10px;
                            Heading { text: "Gnirehtet NG  " + root.version; }
                            Caption { text: "Based on Gnirehtet by Genymobile and its contributors."; }
                            Caption { text: "Source code is distributed under Apache License 2.0."; }
                            HorizontalLayout {
                                spacing: 10px;
                                Button { text: "Project on GitHub"; clicked => { Platform.open-url("https://github.com/Axiomerator/gnirehtet-ng"); } }
                                Rectangle { horizontal-stretch: 1; }
                            }
                            AboutSlint { height: 100px; }
                        }
                    }
                }
            }
        }
    }
}

export component Tray inherits SystemTrayIcon {
    icon: @image-url("../../assets/app-icon-256.png");
    title: "Gnirehtet NG";
    in property <string> status;
    in property <bool> start-enabled;
    in property <bool> stop-enabled;
    in property <bool> restart-enabled;
    visible: false;
    tooltip: "Gnirehtet NG · " + root.status;
    callback open();
    callback action(string);
    clicked => { root.open(); }
    Menu {
        MenuItem { title: "Open Gnirehtet NG"; activated => { root.open(); } }
        MenuSeparator {}
        MenuItem { title: "Start"; enabled: root.start-enabled; activated => { root.action("start"); } }
        MenuItem { title: "Stop"; enabled: root.stop-enabled; activated => { root.action("stop"); } }
        MenuItem { title: "Restart"; enabled: root.restart-enabled; activated => { root.action("restart"); } }
        MenuSeparator {}
        MenuItem { title: "Quit"; activated => { root.action("quit"); } }
    }
}
